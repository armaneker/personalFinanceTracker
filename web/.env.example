# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key
OPENAI_IMPORT_MODEL=gpt-4o-mini

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Authentication Credentials
# Generate password hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
AUTH_USER_EMAIL=admin@example.com
AUTH_USER_PASSWORD_HASH=$2a$10$your-bcrypt-hash-here
