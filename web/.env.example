# ====================================================================
# PERSONAL FINANCE TRACKER - ENVIRONMENT CONFIGURATION
# ====================================================================
#
# Copy this file to .env.local and fill in your actual values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local to version control!
# ====================================================================

# --------------------------------------------------------------------
# OpenAI Configuration (REQUIRED)
# --------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Required for transaction extraction from PDF statements
OPENAI_API_KEY=sk-your-api-key-here

# Model to use for transaction extraction
# Recommended: gpt-4o-mini (cost-effective and accurate)
# Alternatives: gpt-4o, gpt-4-turbo
OPENAI_IMPORT_MODEL=gpt-4o-mini

# --------------------------------------------------------------------
# NextAuth Configuration (REQUIRED)
# --------------------------------------------------------------------
# Secret used to sign JWT tokens
# MUST be at least 32 characters for security
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-chars-here

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------------
# Authentication Credentials (REQUIRED)
# --------------------------------------------------------------------
# Single-user authentication for the application
# Email address for the admin user
AUTH_USER_EMAIL=admin@example.com

# Bcrypt hash of the admin password
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Example for password "admin123":
#   node -e "console.log(require('bcryptjs').hashSync('admin123', 10))"
AUTH_USER_PASSWORD_HASH=$2a$10$your-bcrypt-hash-here

# --------------------------------------------------------------------
# Turso Database Configuration (REQUIRED)
# --------------------------------------------------------------------
# SQLite-compatible database from Turso (https://turso.tech)
#
# Setup instructions:
#   1. Sign up at https://turso.tech
#   2. Install Turso CLI: brew install tursodatabase/tap/turso (macOS)
#   3. Login: turso auth login
#   4. Create database: turso db create personal-finance
#   5. Get URL: turso db show personal-finance --url
#   6. Create token: turso db tokens create personal-finance

# Database URL from Turso (starts with libsql://)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Authentication token from Turso (long JWT token)
TURSO_AUTH_TOKEN=your-auth-token-here

# --------------------------------------------------------------------
# Node Environment (OPTIONAL)
# --------------------------------------------------------------------
# Set to "production" when deploying
# NODE_ENV=development
